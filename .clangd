CompileFlags:
  Add:
    - -xc
    - -std=c11
    - -D_POSIX_C_SOURCE=200809L
    - --target=x86_64-linux-gnu
    - -isystem//wsl.localhost/Ubuntu/usr/lib/gcc/x86_64-linux-gnu/13/include
    - -isystem//wsl.localhost/Ubuntu/usr/include/x86_64-linux-gnu
    - -isystem//wsl.localhost/Ubuntu/usr/include
